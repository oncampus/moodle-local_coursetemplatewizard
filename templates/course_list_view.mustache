<div class="container-fluid">
    <div>
        <table class="table table-striped table-bordered table-sm" id="course-table">

            <h2>{{#str}} headline_table_view, local_oc_course_creation {{/str}}</h2>
            <thead class="table-head-courslist">
            <tr>
                <th class="th-sm col-1">ID</th>
                <th class="th-sm col-1">{{#str}} table_head_shortname, local_oc_course_creation {{/str}}</th>
                <th class="th-sm col-4">{{#str}} table_head_coursename, local_oc_course_creation {{/str}}</th>
                <th class="th-sm col-4">{{#str}} table_head_courseimg, local_oc_course_creation {{/str}}</th>
                <th class="th-sm col-1">
                    <i class="icon custom_entry">
                        {{#str}} table_head_edit, local_oc_course_creation {{/str}}
                    </i>
                </th>
            </tr>
            </thead>
            <tbody>
            {{#courses}}
                <tr class="table-body-courlist">
                    <td class="col-1">{{id}}</td>
                    <td class="col-1">{{shortname}}</td>
                    <td class="col-4">{{fullname}}</td>
                    <td class="col-4">
                            {{index}} image
                    </td>
                    <td class="col-1">
                        <a class="action-copy" href="{{url}}?id={{id}}">
                        <i class="icon fa fa-copy"><!-- --></i>
                        </a>
                    </td>
                </tr>
            {{/courses}}
            </tbody>
        </table>
    </div>

    <br>
    {{#coursesInCat}}
        {{#str}} info_no_courses, local_oc_course_creation {{/str}} <br>
    {{/coursesInCat}}
    <p><small>{{#str}} course_format, local_oc_course_creation {{/str}}: {{courseCategoryName}}</small></p>
</div>
