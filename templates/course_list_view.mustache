{{!
    @template local_coursetemplatwizard/course_list_view

    Template to display the list of usable course templates from the dedicated course template category.

    Context variables required for this template:
    * courses - The course templates to display
    * courseCategoryName - The name of the course category for template courses
    * coursesInCat - A bool, identifying the list of course templates as empty

    Example context (json):
    {
        'courses' : [
            {
                    "id" : 1234,
                    "fullname" : "Course template",
                    "img" : "<img src="https://example.com/pluginfile.php/12345/course/overviewfiles/example.png">",
                    "desc" : "Course template description",
                    "course_url" : "https://example.com/course/view.php?id=123456",
                    "copy_url" : "https://example.com/local/coursetemplatewizard/handle_copy_form.php?templateid=123456&targetcourseid=123",
            }
        ],
        'courseCategoryName' : 'Course templates',
        'coursesInCat' : true,
    }
}}
<div class="container-fluid">
    <div>
        <h2>{{#str}} headline_table_view, local_coursetemplatewizard {{/str}}</h2>
        <table class="table table-striped" id="course-table">
            <thead class="table-head-courslist">
            <tr>
                <th class="th-sm col-2">{{#str}} table_head_coursename, local_coursetemplatewizard {{/str}}</th>
                <th class="th-sm col-3">{{#str}} table_head_courseimg, local_coursetemplatewizard {{/str}}</th>
                <th class="th-sm col-4">{{#str}} table_head_coursetext, local_coursetemplatewizard {{/str}}</th>
                <th class="th-sm col-2">
                </th>
            </tr>
            </thead>
            <tbody>
            {{#courses}}
                {{{out}}}
                <tr class="table-body-courlist">
                    <td class="col-2 align-middle">
                        <a href="{{course_url}}" target="_blank" rel="noopener noreferrer">{{{fullname}}}</a>
                    </td>
                    <td class="col-3 align-middle">
                        <div class="zoomable-image">
                            {{{img}}}
                        </div>
                    </td>
                    <td class="col-4 align-middle">{{{desc}}}</td>
                    <td class="col-2 align-middle">
                        <a class="action-copy btn btn-primary" href="{{{ copy_url }}}">
                        <i class="icon fa fa-copy"><!-- --></i>
                        {{#str}} table_head_edit, local_coursetemplatewizard {{/str}}
                        </a>
                    </td>
                </tr>
            {{/courses}}
            </tbody>
        </table>
        <!--Image Zoom Modal-->
        <div id="imageModal" class="image-modal" aria-hidden="true" role="dialog">
            <span class="image-modal-close">&times;</span>
            <img class="image-modal-content" id="modalImage" alt="">
        </div>
    </div>

    <br>
    {{^coursesInCat}}
        {{#str}} info_no_courses, local_coursetemplatewizard {{/str}} <br>
    {{/coursesInCat}}
    <p><small>{{#str}} course_format, local_coursetemplatewizard {{/str}}: {{courseCategoryName}}</small></p>
</div>
