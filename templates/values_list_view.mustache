<div class="container-fluid">
    <div>
        {{#types}}
            <h2>{{type}}</h2>
            <table class="table table-striped table-bordered table-sm" id="course-table">
                <thead class="table-head-courslist">
                <tr>
                    <th class="th-sm col-1">ID</th>
                    <th class="th-sm col-1">{{#str}} table_head_preset_value, local_oc_course_creation {{/str}}</th>
                    <th class="th-sm col-1">
                        <i class="icon custom_entry">
                            {{#str}} table_head_edit, local_oc_course_creation {{/str}}
                        </i>
                    </th>
                </tr>
                </thead>
                <tbody>
                {{#entries}}
                    <tr class="id:{{id}} table-body-courlist">
                        <td class="col-1">{{id}}</td>
                        <td class="col-8 string_{{id}}">{{string}}</td>
                        <td class="col-1">
                            <div class="row">
                            <div class="ml-3 mr-2">
                            <a href="{{editURL}}?id={{id}}" class=" action-edit">
                                <i class="icon fa fa-cog fa-fw"></i>
                            </a>
                            </div>
                            <a class="id:{{id}} action-delete">
                                <i class="icon fa fa-trash"></i>
                            </a>
                            </div>
                        </td>
                    </tr>
                {{/entries}}
                <tr class="table-body-courslist new-entry-form flex-column justify-content-center">
                    <form action="list_preset_values.php" method="post" id="{{type}}">
                        <td class="col-1 h-100 w-100">
                            <input type="hidden" value="{{type}}" name="type" class="w-100 h-100 "></td>
                        <td class="h-100">
                            <input type="text" name="text" class="w-100 h-100 p-1"/>
                        </td>
                        <td class="col-1">
                            <input  value="{{#str}} table_btn_submit, local_oc_course_creation {{/str}}" type="submit" class="btn btn-secondary"/>
                            </a>
                        </td>
                    </form>
                </tr>
                </tbody>
            </table>
        {{/types}}
        <h2>{{#str}} modal_create_title, local_oc_course_creation {{/str}}</h2>
        <table class="table table-striped table-bordered table-sm" id="course-table">
            <thead class="table-head-courslist">
            <tr>
                <th class="th-sm col-1">{{#str}} table_head_new_type, local_oc_course_creation {{/str}}</th>
                <th class="th-sm col-1">{{#str}} table_head_preset_value, local_oc_course_creation {{/str}}</th>
                <th class="th-sm col-1">
                </th>
            </tr>
            </thead>
            <tbody>
            <tr class="table-body-courlist new-entry-form  align-items-center">
                <form action="list_preset_values.php" method="post">
                    <td class="col-1 h-100 w-100 th-sm col-1>">
                        <input type="text" value="{{type}}" name="type" class="w-100 h-100  p-1"></td>
                    <td class="h-100 th-sm col-8">
                        <input type="text" name="text" class="w-100 h-100  p-1"/>
                    </td>
                    <td class="col-1">
                        <input  value="{{#str}} table_btn_submit, local_oc_course_creation {{/str}}"
                                type="submit" class="btn btn-secondary"/>
                        </a>
                    </td>
                </form>
            </tr>
            </tbody>
        </table>
    </div>
</div>
